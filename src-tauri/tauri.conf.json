{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackPort",
  "version": "0.1.0",
  "identifier": "dev.stackport.app",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "StackPort",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
